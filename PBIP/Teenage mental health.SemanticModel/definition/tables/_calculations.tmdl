table _calculations
	lineageTag: 224da59e-a450-44e4-8bd3-a4cf96f0aabd

	/// Purpose: To combine the various clinical severity indicators (stress_level, anxiety_level, depression_label) into a single, actionable metric of overall psychological burden.
	/// Assumption: All three metrics contribute linearly and equally to total distress.
	measure 'Total Distress Score' = ```
			SUM('Teen_Mental_Health_Dataset'[stress_level]) + 
			                      SUM('Teen_Mental_Health_Dataset'[anxiety_level]) + 
			                      SUM('Teen_Mental_Health_Dataset'[depression_label])
			```
		formatString: 0
		lineageTag: 18127a41-5d13-428d-831c-d865c1bd41dd

	/// Purpose: To measure the quality of sleep relative to screen disruption. This ratio is a common indicator in behavioral health that assesses how much time was spent sleeping versus being kept awake by pre-sleep tech use.
	/// Assumption: The lower the score, the higher the risk of poor sleep hygiene (i.e., too much disruptive screen time).
	measure 'Sleep Efficiency Index' = ```
			DIVIDE(
			    SUM('Teen_Mental_Health_Dataset'[sleep_hours]), 
			    1 + SUM('Teen_Mental_Health_Dataset'[screen_time_before_sleep]) 
			)
			// Note: Added '1 +' to the denominator to prevent division by zero errors.
			```
		lineageTag: dcd306e2-e4c8-42cf-b7a0-8159a7fb9805

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column1
