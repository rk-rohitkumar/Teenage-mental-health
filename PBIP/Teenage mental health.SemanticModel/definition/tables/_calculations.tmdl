table _calculations
	lineageTag: 224da59e-a450-44e4-8bd3-a4cf96f0aabd

	/// Purpose: To combine the various clinical severity indicators (stress_level, anxiety_level, depression_label) into a single, actionable metric of overall psychological burden.
	/// Assumption: All three metrics contribute linearly and equally to total distress.
	measure 'Total Distress Score' = ```
			SUM('Teen_Mental_Health_Dataset'[stress_level]) + 
			                      SUM('Teen_Mental_Health_Dataset'[anxiety_level]) + 
			                      SUM('Teen_Mental_Health_Dataset'[depression_label])
			```
		formatString: 0
		lineageTag: 18127a41-5d13-428d-831c-d865c1bd41dd

	/// Purpose: To measure the quality of sleep relative to screen disruption. This ratio is a common indicator in behavioral health that assesses how much time was spent sleeping versus being kept awake by pre-sleep tech use.
	/// Assumption: The lower the score, the higher the risk of poor sleep hygiene (i.e., too much disruptive screen time).
	measure 'Sleep Efficiency Index' = ```
			DIVIDE(
			    SUM('Teen_Mental_Health_Dataset'[sleep_hours]), 
			    1 + SUM('Teen_Mental_Health_Dataset'[screen_time_before_sleep]) 
			)
			// Note: Added '1 +' to the denominator to prevent division by zero errors.
			```
		lineageTag: dcd306e2-e4c8-42cf-b7a0-8159a7fb9805

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Purpose: To create a composite score indicating overall positive lifestyle factors (physical activity and sleep). This can serve as a potential independent predictor in models.
	/// Assumption: Increased physical activity and sufficient sleep contribute positively to an individual's overall balance.
	measure 'Lifestyle Balance Score' = ```
			SUM('Teen_Mental_Health_Dataset'[physical_activity]) + 
			                          SUM('Teen_Mental_Health_Dataset'[sleep_hours])
			```
		lineageTag: 4867c4c8-8007-4ac4-82f0-9b4118984fdb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// **Definition:** ASR quantifies the relative strength of an individual's physical activity compared to their exposure to pre-sleep digital distraction. It assesses behavioral resilience—the ability of healthy habits to counterbalance poor sleep hygiene.
	/// 
	/// **Calculation:** `SUM('physical_activity') / (1 + SUM('screen_time_before_sleep'))`
	/// 
	/// **Formula Logic:** The ratio divides total accumulated physical activity by a normalized measure of screen time before bed.
	/// 
	/// **Interpretation Guide:**
	/// *   **What it measures:** Behavioral balance and resilience.
	/// *   **Scale Assumption:** A **higher score is generally desirable**, suggesting that high physical activity levels effectively mitigate the negative impact suggested by pre-sleep screen exposure. The `+ 1` in the denominator ensures model stability.
	measure 'Activity vs. Screen Ratio' = ```
			
						DIVIDE(
						    SUM('Teen_Mental_Health_Dataset'[physical_activity]), 
						    1 + SUM('Teen_Mental_Health_Dataset'[screen_time_before_sleep]) 
			            )
			```
		lineageTag: c9d89295-4279-4c38-ab7a-852bd2f90e98

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Normalizes the overall distress score by factoring in general lifestyle balance. A higher ratio indicates that an individual's baseline habits are insufficient to offset their measured psychological burden.
	measure 'TDS/ LBS ratio' = [Total Distress Score] / (1 + [Lifestyle Balance Score])
		lineageTag: b80af3f2-c525-4856-9674-c8e2cc5de0f1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Measures the intensity of emotional strain relative to physical activity level. A higher score suggests that an individual's psychological stress is disproportionately high compared to their healthy behaviors.
	measure 'Stress-to-Activity Ratio (SAR)' = SUM(Teen_Mental_Health_Dataset[stress_level]) / (1 + SUM(Teen_Mental_Health_Dataset[physical_activity]))
		lineageTag: 8c0e235f-ed0c-4d0c-a604-b7aa5a9f68e1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Quantifies the compounded risk by multiplying psychological distress indicators (Stress + Anxiety) by pre-sleep screen time. This highlights individuals with both high emotional burden and poor digital hygiene habits.
	measure 'Compounded Risk Score (CRS)' = ```
			
			    SUM(Teen_Mental_Health_Dataset[stress_level]) + 
			    SUM('Teen_Mental_Health_Dataset'[anxiety_level]) * 
			    SUM('Teen_Mental_Health_Dataset'[screen_time_before_sleep] )
			```
		lineageTag: 4b5db484-7634-4461-acc3-6397ee34b61e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition _calculations = m
